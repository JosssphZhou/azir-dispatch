#!/usr/bin/env python3
"""Run azir-dispatch directly from a source checkout."""

import sys
import os
from pathlib import Path

if len(sys.argv) > 1 and sys.argv[1] == "office":
    office = Path(__file__).resolve().parents[1] / "office" / "office.mjs"
    os.execvp("node", ["node", str(office), *sys.argv[2:]])

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from azir_dispatch.__main__ import main

raise SystemExit(main())
